# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@streamtube.com

# Object storage (MinIO locally, S3 in production) — phase-03-videos/TD-03
# Containers reach MinIO by its Compose service name; presigned URLs for clients
# outside Docker are signed for S3_PUBLIC_ENDPOINT.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=streamtube
S3_SECRET_ACCESS_KEY=streamtube-dev-secret
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true

# Queue (BullMQ on Redis) — phase-03-videos/TD-01
REDIS_HOST=redis
REDIS_PORT=6379

# Video upload and processing — phase-03-videos/TD-02, TD-06, TD-10
VIDEO_MAX_SIZE_BYTES=10737418240
VIDEO_UPLOAD_PART_SIZE_BYTES=67108864
VIDEO_UPLOAD_URL_TTL_SECONDS=3600
VIDEO_UPLOAD_SESSION_TTL_HOURS=24
VIDEO_PROCESSING_ATTEMPTS=3
VIDEO_PROCESSING_BACKOFF_MS=10000
WORKER_CONCURRENCY=2
UPLOAD_SWEEP_INTERVAL_MS=900000
