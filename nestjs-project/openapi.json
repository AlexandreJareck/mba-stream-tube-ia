            }
          }
        },
        "summary": "Get the video thumbnail",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/stream": {
      "get": {
        "description": "Pipes the video from object storage without buffering. Honors a single byte Range so players can start before the whole file is downloaded.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "Single byte range per RFC 9110, e.g. `bytes=0-1048575`, `bytes=1000-` or `bytes=-500`. Invalid or multi-range values are ignored (full 200 response).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whole video (no or unusable Range); Accept-Ranges: bytes",
            "content": {
              "video/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial content with Content-Range: bytes start-end/size",
            "content": {
              "video/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or not ready (VIDEO_NOT_FOUND) or source file missing (VIDEO_SOURCE_MISSING)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Range outside the file (RANGE_NOT_SATISFIABLE); Content-Range: bytes */size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/download": {
      "get": {
        "description": "Same as streaming but with attachment semantics (Content-Disposition); Range is honored for resumable downloads.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "Single byte range per RFC 9110, e.g. `bytes=0-1048575`, `bytes=1000-` or `bytes=-500`. Invalid or multi-range values are ignored (full 200 response).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whole file as an attachment",
            "content": {
              "video/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial content of the attachment",
            "content": {
              "video/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or not ready (VIDEO_NOT_FOUND) or source file missing (VIDEO_SOURCE_MISSING)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Range outside the file (RANGE_NOT_SATISFIABLE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download a video",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {}
      },
      "UploadPartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned S3 UploadPart URL; PUT the part bytes here.",
            "example": "http://localhost:9000/streamtube-videos/videos/…/source?partNumber=1&uploadId=…&X-Amz-Signature=…"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "UploadInstructionsDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "description": "Every part except the last has exactly this size.",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 160
          },
          "expires_at": {
            "type": "string",
            "description": "End of the upload session; afterwards the draft expires.",
            "format": "date-time"
          },
          "url_expires_at": {
            "type": "string",
            "description": "Expiry of the URLs in `parts` (renew via GET …/upload).",
            "format": "date-time"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartUrlDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "expires_at",
          "url_expires_at",
          "parts"
        ]
      },
      "VideoUploadResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "draft"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadInstructionsDto"
          }
        },
        "required": [
          "id",
          "public_id",
          "status",
          "upload"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "size": {
            "type": "number",
            "example": 67108864
          }
        },
        "required": [
          "part_number",
          "size"
        ]
      },
      "UploadSessionResponseDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 160
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "url_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "uploaded_parts": {
            "description": "Parts already stored (from ListParts).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          },
          "parts": {
            "description": "Fresh URLs for the parts still missing.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartUrlDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "expires_at",
          "url_expires_at",
          "uploaded_parts",
          "parts"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "format_name": {
            "type": "object",
            "nullable": true,
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bit_rate": {
            "type": "object",
            "nullable": true,
            "example": 1200000
          },
          "width": {
            "type": "object",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "object",
            "nullable": true,
            "example": 1080
          },
          "video_codec": {
            "type": "object",
            "nullable": true,
            "example": "h264"
          },
          "audio_codec": {
            "type": "object",
            "nullable": true,
            "example": "aac"
          },
          "frame_rate": {
            "type": "object",
            "nullable": true,
            "example": 30
          }
        },
        "required": [
          "format_name",
          "bit_rate",
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "frame_rate"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ"
          },
          "title": {
            "type": "string",
            "example": "My first video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ]
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 10485760
          },
          "duration_seconds": {
            "type": "object",
            "nullable": true,
            "example": 12.5
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "has_thumbnail": {
            "type": "boolean",
            "example": false
          },
          "failure_reason": {
            "type": "object",
            "nullable": true,
            "description": "Failure code when status is failed (INVALID_MEDIA, PROCESSING_FAILED, UPLOAD_EXPIRED).",
            "example": null
          },
          "processing_run": {
            "type": "number",
            "example": 1
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "public_id",
          "title",
          "status",
          "content_type",
          "size_bytes",
          "duration_seconds",
          "metadata",
          "has_thumbnail",
          "failure_reason",
          "processing_run",
          "created_at",
          "updated_at"
        ]
      },
      "PublicVideoResponseDto": {
        "type": "object",
